# CubeGears Company Panel — PRODUCTION BUILD TEMPLATE (public variables).
# Copy to .env.production for local build OR set in Vercel Project Settings.
# These values are bundled into the browser — never put secrets here.
VITE_API_URL=https://api.example.com/api/v1
VITE_USE_MOCK_API=false
VITE_API_TIMEOUT=15000
VITE_API_WITH_CREDENTIALS=false

# The panel checks GET /api/v1/ready/ and reports database/required queue outages.
# It does not connect to PostgreSQL or Redis directly. Keep VITE_API_URL pointing
# to the public HTTPS Django API (ending in /api/v1).
