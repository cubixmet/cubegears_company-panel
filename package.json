{
  "name": "company-panel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check": "oxlint src",
    "build:prod": "npm run check && vite build",
    "test": "node --test tests/*.test.js",
    "test:ui": "node scripts/ui-smoke.mjs",
    "verify": "npm run check && npm test && npm run build && npm run check:bundle",
    "check:bundle": "node scripts/report-bundle.mjs",
    "check:production-env": "node scripts/verify-production-env.mjs",
    "build:production": "npm run check:production-env && npm run build"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "lucide-react": "^1.70.0",
    "react": "^19.0.0",
