# CubeGears Company Panel — LOCAL DEVELOPMENT ENV (public build values only).
# Copy: Copy-Item .env.example .env  (Windows PowerShell)
# Django runs separately on http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000/api/v1
VITE_USE_MOCK_API=false
VITE_API_TIMEOUT=15000
VITE_API_WITH_CREDENTIALS=false
# NEVER put database passwords, Django/JWT secrets or Redis tokens in VITE_*.

# Local Next.js Customer Website origin; change this port if that app runs elsewhere.
# Used ONLY for the Company Panel's development preview. No production hardcode.
VITE_CUSTOMER_WEBSITE_DEV_ORIGIN=http://localhost:5174
